# Настройки автообновления: /etc/cloud-codes/env (читает только root).

# Где лежит клон репозитория и какую ветку разворачивать.
REPO_DIR=/opt/cloud-codes
BRANCH=main

# Какие проекты пересобирать. Через пробел; после двоеточия — compose-файлы
# через запятую (без двоеточия — просто docker-compose.yml).
# Каждому проекту нужен свой .env в его каталоге; без него он пропускается.
PROJECTS="handwriting-ocr:docker-compose.yml,docker-compose.https.yml"
# Пример с ботом:
# PROJECTS="handwriting-ocr:docker-compose.yml,docker-compose.https.yml booking-bot"

# Обновлять только коммиты с зелёным CI на GitHub. 0 — не проверять.
REQUIRE_CI=1
GITHUB_REPO=thugauhobaq-wq/Cloud-codes

# Отчёты в Telegram: токен любого вашего бота (можно того же booking-bot —
# отправка сообщений с опросом не конфликтует) и ваш id от @userinfobot.
# Пусто — отчёты только в журнал: journalctl -u cloud-codes-autoupdate
TG_BOT_TOKEN=
TG_CHAT_ID=
