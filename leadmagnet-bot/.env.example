# ── Telegram ────────────────────────────────────────────────────────────────
# Токен бота от @BotFather
BOT_TOKEN=123456789:AAaaBBbbCCccDDddEEeeFFffGGgg

# Имя бота без @ — из него собираются ссылки вида t.me/bot?start=чеклист
BOT_USERNAME=my_leadmagnet_bot

# Владелец воронки: доступ к админке, рассылкам и выгрузке базы.
# Узнать свой id: напишите @userinfobot
OWNER_ID=123456789

# Дополнительные администраторы через запятую
# ADMIN_IDS=234567890,345678901

# ── Воронка ─────────────────────────────────────────────────────────────────
PROJECT_NAME=Полезные материалы

# Своё приветствие. Если пусто, бот соберёт его из списка кодовых слов.
# WELCOME_TEXT=Привет! Напишите ЧЕКЛИСТ — пришлю материал.

# ── Проверка подписки (необязательно) ───────────────────────────────────────
# Канал, на который нужно подписаться перед выдачей: @channel или -1001234567890.
# Бот должен быть администратором канала, иначе проверка не сработает.
# Пусто — выдаём всем без условий.
# REQUIRED_CHANNEL=@my_channel

# Ссылка для кнопки «Подписаться». Обязательна для приватных каналов,
# у которых нет @username.
# CHANNEL_URL=https://t.me/+privateinvite

# ── Догоняющее сообщение ────────────────────────────────────────────────────
# Второе касание через N часов после выдачи. Текст задаётся на каждый магнит
# командой /followup; без текста догон не отправляется.
FOLLOWUP_ENABLED=true
FOLLOWUP_HOURS=24
FOLLOWUP_INTERVAL_SEC=300

# ── Рассылка ────────────────────────────────────────────────────────────────
# Сообщений в секунду. Telegram гасит рассылку примерно на 30 — 20 с запасом.
BROADCAST_RATE=20

# ── Прочее ──────────────────────────────────────────────────────────────────
# Уведомлять владельца о каждом новом подписчике (у живой воронки это шумно)
NOTIFY_NEW_LEADS=false

DB_PATH=data/leadmagnet.db
LOG_LEVEL=INFO
