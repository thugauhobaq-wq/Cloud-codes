# ── Движок распознавания ────────────────────────────────────────────────────
# claude — языковая модель Anthropic: лучше читает сложный почерк, но фото
#          уходит на серверы за рубежом. Нужен ключ и оплата картой.
# yandex — Yandex Vision OCR: данные остаются в России, оплата в рублях,
#          на неразборчивой прописи ошибается чаще.
OCR_ENGINE=claude

# ── Claude (Anthropic) ──────────────────────────────────────────────────────
# Ключ: console.anthropic.com → API keys → Create key
ANTHROPIC_API_KEY=sk-ant-...

# Модель. Менять не нужно; claude-sonnet-5 — дешевле и чуть слабее.
# CLAUDE_MODEL=claude-opus-5

# Запасной маршрут на стороне API, если модель откажется отвечать.
# Поставьте 0, если API отвечает ошибкой про «fallbacks» или «beta».
# CLAUDE_FALLBACKS=1

# ── Yandex Vision OCR ───────────────────────────────────────────────────────
# В консоли Yandex Cloud: сервисный аккаунт с ролью ai.vision.user →
# создать API-ключ; идентификатор каталога — на странице каталога.
# YC_API_KEY=AQVN...
# YC_FOLDER_ID=b1g...
