# ── Движок распознавания ────────────────────────────────────────────────────
# yandex — Yandex Vision OCR: фото остаётся в России, оплата в рублях,
#          около 12 копеек за снимок. Основной вариант.
# claude — языковая модель Anthropic: лучше читает трудный почерк, но фото
#          уходит на серверы за рубежом, нужен ключ и оплата картой.
OCR_ENGINE=yandex

# ── Yandex Vision OCR ───────────────────────────────────────────────────────
# Как получить (см. README, раздел «Ключи Яндекса»): в консоли Yandex Cloud
# завести сервисный аккаунт с ролью ai.vision.user, создать ему API-ключ;
# идентификатор каталога — на странице каталога.
YC_API_KEY=AQVN...
YC_FOLDER_ID=b1g...

# Языки рукописи через запятую: ru, en или ru,en. Других модель не знает.
# YC_LANGUAGES=ru

# ── Claude (Anthropic) ──────────────────────────────────────────────────────
# Ключ: console.anthropic.com → API keys → Create key
# ANTHROPIC_API_KEY=sk-ant-...

# Модель. Менять не нужно; claude-sonnet-5 — дешевле и чуть слабее.
# CLAUDE_MODEL=claude-opus-5

# Запасной маршрут на стороне API, если модель откажется отвечать.
# Поставьте 0, если API отвечает ошибкой про «fallbacks» или «beta».
# CLAUDE_FALLBACKS=1
