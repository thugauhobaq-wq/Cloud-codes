FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# botkit лежит в vendor/ прямо в этом репозитории: ничего рядом искать не
# нужно, сборка идёт из корня репозитория одной командой:
#     docker build -t {{project}} .
COPY vendor/botkit /app/vendor/botkit
RUN pip install --no-cache-dir /app/vendor/botkit

# Зависимости отдельным слоем: правка кода не заставляет ставить их заново.
COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-cache-dir .

# Процесс не должен ходить под root — ему нужен только каталог с базой.
RUN useradd --create-home --uid 1000 bot \
    && mkdir -p /app/data \
    && chown -R bot:bot /app
USER bot

VOLUME ["/app/data"]

ENV DB_PATH=/app/data/{{pkg}}.db

CMD ["python", "-m", "{{pkg}}", "run"]
