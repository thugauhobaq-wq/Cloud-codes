[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[project]
name = "{{project}}"
version = "0.1.0"
description = "{{title}}"
readme = "README.md"
requires-python = ">=3.11"
# botkit пока не опубликован в PyPI, поэтому ставится отдельно:
#     pip install -e ../botkit
# Когда он появится в индексе, добавьте его сюда как обычную зависимость.
dependencies = [
    "aiogram>=3.4,<4",
    "aiosqlite>=0.20",
    "pydantic>=2.6",
    "pydantic-settings>=2.2",
]

[project.optional-dependencies]
dev = [
    "pytest>=8.0",
    "pytest-asyncio>=0.23",
    "ruff>=0.4",
]

[project.scripts]
{{pkg}} = "{{pkg}}.__main__:main"

[tool.hatch.build.targets.wheel]
packages = ["src/{{pkg}}"]

[tool.ruff]
line-length = 100
target-version = "py311"
src = ["src", "tests"]

[tool.ruff.lint]
select = ["E", "F", "W", "I", "UP", "B", "C4", "SIM", "RUF"]
ignore = [
    "RUF001",  # кириллица в строках — интерфейс русскоязычный
    "RUF002",
    "RUF003",
    "B008",
]

[tool.pytest.ini_options]
testpaths = ["tests"]
asyncio_mode = "auto"
