#!/bin/sh
# Выравнивает права на каталоге с базой и понижает привилегии.
#
# `./data` монтируется с хоста и принадлежит root, а бот работает под
# непривилегированным пользователем. Без этого первый же запуск падает на
# «unable to open database file»: у автора, который каталог уже создал, всё
# работает, а у заказчика после `docker compose up` бот не стартует.
set -e

APP_USER="${APP_USER:-bot}"

if [ "$(id -u)" = "0" ]; then
    mkdir -p /app/data
    chown -R "$APP_USER" /app/data
    # setpriv, а не runuser или su: те заводят сессию с собственным шеллом,
    # который съедает вывод бота (docker logs пустеет) и на SIGTERM убивает
    # процесс, не давая закрыть базу. setpriv меняет пользователя и делает
    # exec, поэтому бот остаётся PID 1 и получает сигналы напрямую.
    exec setpriv --reuid="$APP_USER" --regid="$APP_USER" --init-groups \
        --inh-caps=-all -- "$@"
fi

# Уже не root: контейнер запустили с явным --user, права выставлены снаружи.
exec "$@"
