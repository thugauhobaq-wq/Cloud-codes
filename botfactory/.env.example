# ── Telegram ────────────────────────────────────────────────────────────────
# Токен бота от @BotFather
BOT_TOKEN=123456789:AAaaBBbbCCccDDddEEeeFFffGGgg

# Владелец: только он может заказывать ботов — бот пушит под вашим токеном.
# Узнать свой id: напишите @userinfobot
OWNER_ID=123456789

# Дополнительные администраторы через запятую
# ADMIN_IDS=234567890,345678901

# ── GitHub ──────────────────────────────────────────────────────────────────
# Personal access token с правом создавать репозитории:
#   classic       — scope «repo»
#   fine-grained  — Repository permissions → Administration: Read and write,
#                   Contents: Read and write
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Владелец репозиториев: организация или пусто — тогда аккаунт владельца токена
# GITHUB_OWNER=

# Куда публиковать по умолчанию:
#   repo   — новый отдельный репозиторий на каждого бота
#   branch — ветка в репозитории из REPO_ROOT
PUBLISH_MODE=repo

# Новые репозитории приватные
PRIVATE_REPOS=true

# ── Каталоги ────────────────────────────────────────────────────────────────
# Где генерируются проекты в режиме repo
WORKDIR=data/projects

# Рабочая копия репозитория для режима branch: у неё должен быть remote origin
# и права на пуш.
REPO_ROOT=.

# ── Прочее ──────────────────────────────────────────────────────────────────
DB_PATH=data/botfactory.db
LOG_LEVEL=INFO
