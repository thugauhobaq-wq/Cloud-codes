# ── Telegram ────────────────────────────────────────────────────────────────
# Токен бота от @BotFather
BOT_TOKEN=123456789:AAaaBBbbCCccDDddEEeeFFffGGgg

# Имя бота без @ — из него собирается ссылка для поста в канале
# (t.me/имя_бота?start=g12 ведёт человека сразу к нужному розыгрышу)
BOT_USERNAME=my_giveaway_bot

# Владелец: заводит розыгрыши, подводит итоги, видит участников.
# Узнать свой id: напишите @userinfobot
OWNER_ID=123456789

# Дополнительные администраторы через запятую
# ADMIN_IDS=234567890,345678901

# ── Розыгрыши ───────────────────────────────────────────────────────────────
PROJECT_NAME=Розыгрыши

# Куда публиковать объявление с победителями: @channel или -1001234567890.
# Бот должен быть администратором этого канала.
# Пусто — бот пришлёт готовый текст владельцу, тот опубликует сам.
# ANNOUNCE_CHAT=@my_channel

# Каналы, подписка на которые нужна по умолчанию (через запятую).
# У каждого розыгрыша может быть свой список — он задаётся при создании.
# Бот должен быть администратором каждого канала, иначе проверить подписку
# нечем и бот пускает всех.
# DEFAULT_CHANNELS=@my_channel,@second_channel

# Как часто проверять, не пора ли подводить итоги (секунды)
DEADLINE_INTERVAL_SEC=60

# Сколько часов ждать ответа победителя, прежде чем предлагать перевыбор
CLAIM_HOURS=48

# ── Прочее ──────────────────────────────────────────────────────────────────
DB_PATH=data/giveaway.db
LOG_LEVEL=INFO
