# ── Telegram ────────────────────────────────────────────────────────────────
# Токен бота от @BotFather
BOT_TOKEN=123456789:AAaaBBbbCCccDDddEEeeFFffGGgg

# Владелец: получает заказы и имеет доступ к админке.
# Узнать свой id: напишите @userinfobot
OWNER_ID=123456789

# Дополнительные администраторы через запятую
# ADMIN_IDS=234567890,345678901

# ── Магазин ─────────────────────────────────────────────────────────────────
SHOP_NAME=Кофейня «Зерно»
SHOP_ABOUT=Обжариваем сами, отправляем в день заказа.
CONTACTS=@zerno_shop, +7 900 000-00-00
CURRENCY=₽

# ── Доставка ────────────────────────────────────────────────────────────────
# Адрес самовывоза. Оставьте пустым, если самовывоза нет.
PICKUP_ADDRESS=Ленина, 15

# Доставка курьером
DELIVERY_ENABLED=true
DELIVERY_PRICE=300

# Сумма, от которой доставка бесплатна (0 — не применять)
FREE_DELIVERY_FROM=3000

# Минимальная сумма заказа (0 — без порога)
MIN_ORDER=0

# ── Витрина ─────────────────────────────────────────────────────────────────
# Сколько товаров показывать на странице каталога
PAGE_SIZE=6

# Считать остатки: списывать при заказе и прятать распроданное
TRACK_STOCK=true

# ── Прочее ──────────────────────────────────────────────────────────────────
DB_PATH=data/shop.db
LOG_LEVEL=INFO
