# ── Telegram ────────────────────────────────────────────────────────────────
# Токен бота от @BotFather
BOT_TOKEN=123456789:AAaaBBbbCCccDDddEEeeFFffGGgg

# Куда слать заказы: id канала (обычно с минусом, например -1001234567890)
# или твой личный chat_id, если хочешь в личку.
TARGET_CHAT_ID=-1001234567890

# Твой Telegram user id. Только он может менять настройки командами бота.
# Узнать: напиши боту /start — он ответит твоим id.
OWNER_ID=123456789

# ── Опрос ───────────────────────────────────────────────────────────────────
# Базовый интервал опроса в секундах (к нему добавляется случайный джиттер ±30%)
POLL_INTERVAL=180

# Путь к файлу SQLite с состоянием
DB_PATH=data/fparser.db

# ── Сеть (необязательно) ────────────────────────────────────────────────────
# HTTP(S)-прокси, если биржи режут твой IP. Пример: http://user:pass@host:3128
# HTTP_PROXY_URL=

# Таймаут HTTP-запроса, секунды
REQUEST_TIMEOUT=25

# ── Источники с настройками ─────────────────────────────────────────────────
# Telegram-каналы с заказами. Значение отсюда применяется только при самом
# первом запуске — дальше список живёт в базе и правится командами /tg_add
# и /tg_del, чтобы добавленный канал не затирался при рестарте.
# TG_CHANNELS=freelansim_ru, другой_канал

# Строка поиска вакансий на hh.ru. Токен не нужен: поиск открыт.
# HH_QUERY=telegram бот

# Ключ Freelancehunt из раздела Apps and API. Без него площадка молчит.
# FREELANCEHUNT_TOKEN=

# ── Адреса лент (необязательно) ─────────────────────────────────────────────
# Раскомментируй и подставь свой адрес, если биржа переехала или ты хочешь
# следить за конкретной категорией, а не за общей лентой.
# FEED_URL_KWORK=https://kwork.ru/projects
# FEED_URL_FLRU=https://www.fl.ru/rss/all.xml
# FEED_URL_HABR=https://freelance.habr.com/tasks.rss
# FEED_URL_WEBLANCER=https://www.weblancer.net/rss/projects/
# FEED_URL_HH=https://api.hh.ru/vacancies
# FEED_URL_FH=https://api.freelancehunt.com/v2/projects

# ── Логи ────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
