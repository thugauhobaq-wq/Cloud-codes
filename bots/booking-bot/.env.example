# ── Telegram ────────────────────────────────────────────────────────────────
# Токен бота от @BotFather
BOT_TOKEN=123456789:AAaaBBbbCCccDDddEEeeFFffGGgg

# Владелец: получает уведомления о записях и имеет доступ к админке.
# Узнать свой id: напишите @userinfobot
OWNER_ID=123456789

# Дополнительные администраторы через запятую (например, мастера)
# ADMIN_IDS=234567890,345678901

# ── Точка ───────────────────────────────────────────────────────────────────
BUSINESS_NAME=Барбершоп на Ленина
BUSINESS_ADDRESS=Ленина, 15, второй этаж
BUSINESS_PHONE=+7 900 000-00-00

# Часовой пояс точки. Список: Europe/Moscow, Asia/Yekaterinburg, Europe/Kyiv…
TIMEZONE=Europe/Moscow

# ── Правила записи ──────────────────────────────────────────────────────────
# На сколько дней вперёд открыта запись
HORIZON_DAYS=14

# Шаг сетки слотов в минутах: 30 — это 10:00, 10:30, 11:00…
SLOT_STEP_MIN=30

# Нельзя записаться позже, чем за столько минут до начала
MIN_LEAD_MIN=60

# За сколько минут до визита закрывается самостоятельная отмена
CANCEL_DEADLINE_MIN=120

# ── Напоминания ─────────────────────────────────────────────────────────────
# За сколько минут напоминать о визите
REMINDER_LEAD_MIN=60

# Как часто проверять очередь напоминаний, секунды
REMINDER_INTERVAL_SEC=60

# ── Прочее ──────────────────────────────────────────────────────────────────
DB_PATH=data/booking.db
LOG_LEVEL=INFO
